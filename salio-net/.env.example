# Salio's settings on the server. Copy to .env and fill in:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored and kept out of every image. NEVER commit it, never
# paste it into a chat. This file (.env.example) holds no secrets.

# --- Secret -----------------------------------------------------------------
# Database password. Generate a NEW one ON THE SERVER, never reuse the
# laptop's:
#   openssl rand -hex 24
# Letters and digits only (hex is): it is placed inside a connection string,
# where ; or = would break it.
# It is applied only when the database volume is first created. To change it
# later, follow "Changing the database password" in deploy/DEPLOY.md.
POSTGRES_PASSWORD=

# --- Must be set ------------------------------------------------------------
# The domain the till is served on. No https://, no slash, no port.
# Typed here and nowhere else: Caddy, the API's allowed host and the setup
# links all read it from this line.
SALIO_DOMAIN=

# Image tag to run. Use a new one for each release (the runbook uses the
# date and time). To go back to the previous release, put its tag back here.
SALIO_VERSION=

# --- Which Caddy (deploy/DEPLOY.md step 2) ----------------------------------
# Path A - nothing on the server uses ports 80/443 yet: set this to caddy
#          and Salio runs its own Caddy container.
# Path B - a Caddy already runs on the server for the other site: leave it
#          EMPTY. That Caddy forwards to the two 127.0.0.1 ports below.
COMPOSE_PROFILES=

# --- Usually left alone -----------------------------------------------------
# Ports on 127.0.0.1 (never public). Change only if something else on the
# server already uses them.
SALIO_API_PORT=18080
SALIO_WEB_PORT=18081

# Path A only: the public ports Salio's Caddy listens on. 80 and 443 on the
# server. Other values (8080 / 8443) are for trying the stack on a laptop.
SALIO_HTTP_PORT=80
SALIO_HTTPS_PORT=443

# The address in setup links. Empty means https://<SALIO_DOMAIN>, which is
# right on the server. Set only for a laptop test, e.g. https://localhost:8443
SALIO_PUBLIC_URL=

# Memory ceilings. Lower SALIO_DB_MEM to 512m only if the server is short of
# memory (deploy/DEPLOY.md step 2 says when).
SALIO_DB_MEM=1g
SALIO_API_MEM=512m

# Invoice reader for Scan invoice. To switch it on: INVOICE_READER_PROVIDER=anthropic
# and an Anthropic API key. Leave the key empty to keep it off. The model is
# optional: empty means claude-haiku-5-5; claude-sonnet-5-5 reads hard handwriting better.
INVOICE_READER_PROVIDER=
INVOICE_READER_API_KEY=
INVOICE_READER_MODEL=
